{
  "schemaVersion": 1,
  "id": "ftbq_linespacing",
  "version": "${version}",
  "name": "FTB Quests Line Spacing",
  "description": "Improves FTB Quests readability: adjustable line spacing in quest descriptions, and a card-style chapter list with completion percentages. Configurable via config/ftbq-linespacing.properties.",
  "authors": ["mockmock"],
  "contact": {
    "homepage": "https://github.com/mockmock69401/ftbq-linespacing",
    "sources": "https://github.com/mockmock69401/ftbq-linespacing",
    "issues": "https://github.com/mockmock69401/ftbq-linespacing/issues"
  },
  "license": "MIT",
  "environment": "client",
  "mixins": [
    "ftbq_linespacing.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "ftbquests": ">=2101.1.35 <2101.2.0",
    "ftblibrary": ">=2101.1.36 <2101.2.0"
  }
}
